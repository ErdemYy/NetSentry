# NetSentry AI — Global Environment Template
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_USER=netsentry
POSTGRES_PASSWORD=netsentry_dev_secret_change_me
POSTGRES_DB=netsentry_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://netsentry:netsentry_dev_secret_change_me@localhost:5432/netsentry_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Services
API_PORT=3001
WEB_PORT=3000
ML_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# Authentication & Security
JWT_SECRET=netsentry_jwt_random_secret_development_only
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
ADMIN_INITIAL_PASSWORD=<replace_with_secure_admin_password_min_12_chars>
ANALYST_INITIAL_PASSWORD=<replace_with_secure_analyst_password_min_12_chars>
