# NetSentry AI — Global Environment Template (Development Placeholders)
NODE_ENV=development

# Database (PostgreSQL)
POSTGRES_USER=netsentry
POSTGRES_PASSWORD=netsentry_dev_secret_change_me
POSTGRES_DB=netsentry_db
POSTGRES_PORT=5433
DATABASE_URL="postgresql://netsentry:netsentry_dev_secret_change_me@localhost:5433/netsentry_db?schema=public"

# Redis Streams & Cache
REDIS_HOST=localhost
REDIS_PORT=6380
CLAIM_IDLE_MS=30000

# Services Endpoints
API_PORT=3001
WEB_PORT=3000
ML_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# Authentication & Security
JWT_SECRET=netsentry_jwt_random_secret_development_only
INTERNAL_SERVICE_TOKEN=netsentry_internal_token_development_only
ML_INTERNAL_AUTH_ENABLED=true
NETSENTRY_PCAP_ROOT=./apps/ml/data/pcap
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
ADMIN_INITIAL_PASSWORD=AdminPassword123!
ANALYST_INITIAL_PASSWORD=AnalystPassword123!
